{
    "name": "hiblaphp/http-client",
    "type": "library",
    "license": "MIT",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Hibla\\HttpClient\\": "src/"
        },
        "files": [
            "src/functions.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "Reymart A. Calicdan",
            "email": "reymart.calicdan@evsu.edu.ph"
        }
    ],
    "require": {
        "php": "^8.3",
        "hiblaphp/event-loop": "dev-main",
        "hiblaphp/promise": "dev-main",
        "hiblaphp/async": "dev-main",
        "hiblaphp/stream": "dev-main",
        "psr/http-message": "^2.0"
    },
    "require-dev": {
        "pestphp/pest": "^4.0",
        "rcalicdan/config-loader": "^1.0",
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-strict-rules": "^2.0",
        "laravel/pint": "^1.25",
        "mockery/mockery": "^1.6"
    },
    "scripts": {
        "analyze": "./vendor/bin/phpstan analyse",
        "format": "./vendor/bin/pint",
        "format-test": "./vendor/bin/pint --test",
        "test": "./vendor/bin/pest",
        "docker:network": "@php docker/create-network.php",
        "proxy:env": "@php -r \"file_exists('docker/proxy/.env') || copy('docker/proxy/.env.example', 'docker/proxy/.env');\"",
        "proxy:up": [
            "@proxy:env",
            "@docker:network",
            "docker compose -f docker/proxy/docker-compose.yml --env-file docker/proxy/.env up -d"
        ],
        "proxy:down": "docker compose -f docker/proxy/docker-compose.yml down",
        "proxy:logs": "docker compose -f docker/proxy/docker-compose.yml logs -f",
        "proxy:reset": [
            "@proxy:down",
            "@proxy:up"
        ],
        "httpbin:env": "@php -r \"file_exists('docker/httpbin/.env') || copy('docker/httpbin/.env.example', 'docker/httpbin/.env');\"",
        "httpbin:up": [
            "@httpbin:env",
            "@docker:network",
            "docker compose -f docker/httpbin/docker-compose.yml --env-file docker/httpbin/.env up -d",
            "@php -r \"sleep(2);\""
        ],
        "httpbin:down": "docker compose -f docker/httpbin/docker-compose.yml down",
        "httpbin:logs": "docker compose -f docker/httpbin/docker-compose.yml logs -f",
        "httpbin:reset": [
            "@httpbin:down",
            "@httpbin:up"
        ]
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}